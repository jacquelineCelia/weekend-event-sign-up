# Postgres connection string (Supabase: Project settings → Database → Connection string, "Transaction pooler")
DATABASE_URL=postgres://postgres@localhost:5433/signup?host=/tmp
# Set to true for hosted databases that require TLS (Supabase)
DATABASE_SSL=false
# Random string of at least 32 characters, used to sign the "remember me" cookie
SESSION_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
# Event settings
NEXT_PUBLIC_EVENT_NAME=Mindfulness Weekend
# Event name on Traditional Chinese pages and messages
NEXT_PUBLIC_EVENT_NAME_ZH=正念週末
# Who runs the event and where people write for help (shown on Terms/Privacy and in texting wording)
NEXT_PUBLIC_ORG_NAME=Yellow Flower Meditation Academy
NEXT_PUBLIC_SUPPORT_EMAIL=support@onenesstruth.org
# Simplified Chinese name: optional. Leave unset and it is converted from the Traditional name above.
# NEXT_PUBLIC_EVENT_NAME_ZHS=正念周末
EVENT_TZ=America/New_York
# Shared passcode for the staff tools at /staff (at least 8 characters)
STAFF_PASSCODE=change-me
# Public URL of the app, used for links in emails
APP_URL=http://localhost:3000
# Bearer token the scheduler sends to /api/cron/reminders
CRON_SECRET=change-me-to-a-random-string
# Email via Twilio SendGrid (without a key, messages are printed to the server log).
# EMAIL_FROM must use a domain or sender verified in SendGrid.
SENDGRID_API_KEY=
EMAIL_FROM=Mindfulness Weekend <hello@example.com>
# Text messages via Twilio (without these, reminders go by email only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
